{
  "name": "@act-sdk/adapters",
  "version": "3.0.1",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio/index.d.ts",
      "import": "./dist/stdio/index.js"
    },
    "./nextjs": {
      "types": "./dist/nextjs/index.d.ts",
      "import": "./dist/nextjs/index.js"
    },
    "./express": {
      "types": "./dist/express/index.d.ts",
      "import": "./dist/express/index.js"
    },
    "./hono": {
      "types": "./dist/hono/index.d.ts",
      "import": "./dist/hono/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "pnpm run build",
    "dev": "tsup --watch",
    "typecheck": "pnpm -s tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @act-sdk/core build && pnpm run build && node --test test/**/*.test.mjs"
  },
  "dependencies": {
    "@act-sdk/core": "workspace:*",
    "@act-sdk/mcp": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.1"
  },
  "peerDependencies": {
    "express": "^4.21.0 || ^5.0.0",
    "hono": "^4.0.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "express": "^5.1.0",
    "hono": "^4.7.0"
  }
}
